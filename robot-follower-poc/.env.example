# Copy to .env and adjust for your machine.

# Perception / camera
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Vision backend: hog (default) | ultralytics_yolo_botsort | ultralytics_yolo_bytetrack
# Ultralytics backends require: pip install -e ".[vision-ultralytics]" (AGPL-3.0 — see README)
VISION_BACKEND=hog
YOLO_MODEL=yolo11n.pt
YOLO_TRACKER=botsort.yaml
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.5
YOLO_DEVICE=cpu
YOLO_IMAGE_SIZE=640
YOLO_SHOW_DEBUG=false
YOLO_PERSIST_TRACKS=true
TARGET_LOCK_MAX_LOST_FRAMES=15

TARGET_LOST_TIMEOUT_S=2.0
CALIBRATION_CONSTANT_M_PX=250
HOG_WIN_STRIDE=4
HOG_PADDING=8
HOG_SCALE=1.05

# Motion planner thresholds
DESIRED_DISTANCE_M=2.0
DISTANCE_TOO_FAR_M=2.5
DISTANCE_TOO_CLOSE_M=1.2
HORIZONTAL_OFFSET_THRESHOLD=0.15

# Simulated motor
MOTOR_MAX_SPEED=1.0
MOTOR_COMMAND_TIMEOUT_S=0.5
MOTOR_LOG_INTERVAL_S=0.25
# Recent motor primitives in GET /status and WebSocket (dashboard)
MOTOR_COMMAND_HISTORY_MAX=10
# Upper-body JPEG thumbnails in status (orchestrator + perception pipeline only)
DASHBOARD_TARGET_THUMBNAILS_ENABLED=true
DASHBOARD_MAX_THUMBNAIL_TRACKS=8

# API
API_HOST=127.0.0.1
API_PORT=8000
ROBOT_API_BASE=http://127.0.0.1:8000
# Browser origins for the React dashboard (comma-separated). Empty disables CORS middleware.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Orchestrator
ORCHESTRATOR_PERIOD_S=0.05
STATUS_LOG_INTERVAL_S=1.0

# Audio ingress TTL (seconds without /audio/listening heartbeat → dashboard shows idle)
AUDIO_LISTENING_TTL_S=15.0

# ElevenLabs Conversational AI (optional; pip install -e ".[audio-elevenlabs]")
ELEVENLABS_AUDIO_ENABLED=false
ELEVENLABS_AGENT_ID=agent_5301kqpx6qheej0a0qvmhkqm0236
ELEVENLABS_API_KEY=
ELEVENLABS_REQUIRES_AUTH=true
ELEVENLABS_USE_SIGNED_URL=true
ELEVENLABS_TRANSCRIPT_MAX_ITEMS=200
ELEVENLABS_COMMAND_CONFIDENCE_THRESHOLD=0.70
ELEVENLABS_AUTO_START=false

# Logging
LOG_LEVEL=INFO
